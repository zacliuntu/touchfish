{
  "name": "touchfish",
  "productName": "TouchFish",
  "desktopName": "touchfish",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Arrange a web target and desktop application across one or more displays.",
  "homepage": "https://github.com/zacliuntu/touchfish",
  "author": {
    "name": "zacliuntu",
    "email": "zacliuntu@users.noreply.github.com"
  },
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "package:linux": "pnpm build && electron-builder --linux deb --x64",
    "package:win": "pnpm build && electron-builder --win nsis --x64",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "i18next": "26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
